<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Bazaar Flipper – Hypixel SkyBlock</title>
<style>
:root{--bg:#0f1115;--card:#171a21;--line:#262b36;--tx:#e6e9ef;--mut:#8b93a3;--ac:#5eead4;--up:#4ade80;--dn:#f87171;--warn:#fbbf24}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:14px/1.45 system-ui,sans-serif}
header{padding:14px 16px;border-bottom:1px solid var(--line);display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between}
h1{font-size:18px;margin:0}
.mut{color:var(--mut)}
.ctl{display:flex;flex-wrap:wrap;gap:10px;align-items:end}
label{display:flex;flex-direction:column;font-size:11px;color:var(--mut);gap:2px}
input,select{background:var(--card);color:var(--tx);border:1px solid var(--line);border-radius:6px;padding:6px 8px;font:inherit;width:130px}
select{width:90px}
main{padding:14px 16px;max-width:1100px;margin:0 auto}
nav{display:flex;flex-wrap:wrap;gap:6px}
nav button{background:var(--card);color:var(--tx);border:1px solid var(--line);border-radius:999px;padding:6px 12px;cursor:pointer;font:inherit}
nav button.on{background:var(--ac);color:#062b26;border-color:var(--ac);font-weight:600}
.wrap{overflow-x:auto;border:1px solid var(--line);border-radius:10px;background:var(--card)}
table{border-collapse:collapse;width:100%;min-width:760px}
th,td{padding:8px 10px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}
th:first-child,td:first-child{text-align:left}
th{color:var(--mut);font-weight:500;font-size:12px;position:sticky;top:0;background:var(--card)}
tbody tr{cursor:pointer}
tbody tr:hover{background:#1d212b}
.up{color:var(--up)}.dn{color:var(--dn)}.warn{color:var(--warn)}
#det{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:14px;margin:12px 0}
#det:empty{display:none}
#det h2{margin:0 0 6px;font-size:16px;display:flex;justify-content:space-between}
#det button{background:none;border:0;color:var(--mut);cursor:pointer;font-size:18px}
.g{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:8px;margin:8px 0}
.g div{background:var(--bg);border-radius:8px;padding:8px}
.g b{display:block;font-size:15px}
.books{display:grid;grid-template-columns:1fr 1fr;gap:12px;font-size:12px}
.books td,.books th{padding:3px 6px}
.foot{font-size:12px;margin-top:12px}
.chip{padding:2px 8px;border-radius:999px;font-size:12px;font-weight:600}
.BUY{background:#14532d;color:#86efac}.WAIT{background:#713f12;color:#fde68a}.AVOID{background:#7f1d1d;color:#fecaca}.HOLD{background:#262b36;color:#cbd5e1}
.why{white-space:normal;text-align:left!important;min-width:220px;color:var(--mut)}
</style></head><body>
<header>
<div><h1>🪙 Bazaar Flipper</h1><div class="mut" id="st">Loading…</div></div>
<div class="ctl">
<label>Sell tax<select id="tax"><option value="1.25">1.25%</option><option value="1.125">1.125%</option><option value="1">1%</option></select></label>
<label>Purse (coins)<input id="purse" type="number" min="0" step="100000"></label>
<label>Min weekly volume<input id="mv" type="number" min="0" step="10000"></label>
<label>Fill share %<input id="sh" type="number" min="1" max="100"></label>
<label>Alerts<select id="al"><option value="0">Off</option><option value="1">On</option></select></label><label>Alert min score<input id="mc" type="number" min="1" max="100"></label><label>Search<input id="q" placeholder="Item name…"></label>
</div></header>
<main>
<nav id="tabs"></nav>
<p id="desc" class="mut"></p>
<div id="det"></div>
<div class="wrap"><table><thead><tr id="hd">
<th>Item</th><th>Buy order @</th><th>Sell offer @</th><th>Profit/item</th><th>Margin</th><th>Weekly vol</th><th>Est. coins/hr</th><th>vs 24h avg</th><th>Flag</th>
</tr></thead><tbody id="rows"></tbody></table></div>
<p class="mut foot">Flip = place a buy order 0.1 above the top buy order, then list a sell offer 0.1 below the lowest sell offer (sell tax deducted). “Est. coins/hr” assumes you capture your chosen share of hourly volume, capped by your purse — it is a rough guide, not a promise. Price history is recorded by this page every 5 min while it is open (top 200 items by volume, last 24h) and stored in your browser. Signals use RSI, Bollinger bands, EMA trend, spread z-score and hour-of-day seasonality (they need ~100 min of data; seasonality ~3 days). They are heuristics, not guarantees. Always sanity-check the order book before committing coins.</p>
</main>
<script>
const API='https://api.hypixel.net/v2/skyblock/bazaar';
const $=s=>document.querySelector(s);
const S={raw:{},hist:[],tab:'quick',sel:null};
let cfg={tax:1.25,purse:10000000,minVol:100000,share:10,al:0,mc:70},SEAS={},SER={};
try{Object.assign(cfg,JSON.parse(localStorage.getItem('bzc')||'{}'));S.hist=JSON.parse(localStorage.getItem('bzh')||'[]');SEAS=JSON.parse(localStorage.getItem('bzs')||'{}')}catch(e){}

const TABS={
 sig:{n:'🎯 Signals',d:'Analyst-style calls from RSI, Bollinger bands, EMA trend, spread z-score and hour-of-day seasonality. BUY = the flip is profitable and the price looks like a good entry right now.',f:r=>r.sg&&r.profit>0&&r.vol>=cfg.minVol&&r.sg.act!='AVOID',s:r=>(r.sg.act=='BUY'?1000:0)+r.sg.conf},
 quick:{n:'⚡ Quick',d:'High-volume items with healthy 1–15% margins: fast fills and steady profit.',f:r=>r.m>=1&&r.m<=15&&r.vol>=Math.max(cfg.minVol,300000),s:r=>r.hr},
 margin:{n:'💎 High margin',d:'Margins of 15%+. Bigger percentages, but slower fills and a higher chance the spread is manipulated.',f:r=>r.m>=15&&r.m<=200&&r.vol>=cfg.minVol,s:r=>r.m},
 bulk:{n:'📦 Cheap bulk',d:'Items under 1,000 coins: stack them in bulk, great with a small purse.',f:r=>r.buy<=1000&&r.profit>0&&r.vol>=cfg.minVol,s:r=>r.hr},
 big:{n:'🐋 Big ticket',d:'Items over 250k coins: huge profit per item, but fewer flips per hour.',f:r=>r.buy>=250000&&r.profit>0&&r.vol>=500,s:r=>r.profit},
 dip:{n:'📉 Dip buys',d:'Top buy-order price sits 3%+ below its 24h average. Buy the dip, sell on recovery. Needs history (leave the page open ~30 min).',f:r=>r.dip>=3&&r.profit>0&&r.vol>=cfg.minVol/2,s:r=>r.dip},
 all:{n:'All items',d:'Every Bazaar item, sorted by weekly volume.',f:()=>true,s:r=>r.vol}
};

const nm=id=>id.toLowerCase().split('_').map(w=>w.charAt(0).toUpperCase()+w.slice(1)).join(' ');
const fmt=n=>{const a=Math.abs(n);return a>=1e9?(n/1e9).toFixed(2)+'B':a>=1e6?(n/1e6).toFixed(2)+'M':a>=1e4?(n/1e3).toFixed(1)+'k':n.toLocaleString(undefined,{maximumFractionDigits:1})};
const r1=v=>Math.round(v*10)/10;

function avgMap(){
 const a={},cut=Date.now()-864e5;
 S.hist.forEach(h=>{if(h.t<cut)return;for(const id in h.p)(a[id]=a[id]||[]).push(h.p[id][1])});
 return a;
}

function calc(){
 const t=cfg.tax/100,av=avgMap(),out=[];SER=series();
 for(const p of Object.values(S.raw)){
  const q=p.quick_status,a=p.buy_summary[0],b=p.sell_summary[0];
  if(!a||!b)continue;
  const ask=a.pricePerUnit,bid=b.pricePerUnit; // ask = lowest sell offer, bid = highest buy order
  const buy=r1(bid+0.1),sell=r1(ask-0.1);
  const profit=sell*(1-t)-buy,m=profit/buy*100;
  const vol=Math.min(q.buyMovingWeek,q.sellMovingWeek);
  const perHr=vol/168*cfg.share/100;
  const hr=Math.max(0,profit)*Math.min(perHr,cfg.purse/buy);
  const h=av[p.product_id];
  const dip=h&&h.length>=6?(h.reduce((x,y)=>x+y,0)/h.length-bid)/(h.reduce((x,y)=>x+y,0)/h.length)*100:null;
  let flag='';
  if(m>40)flag='⚠ manipulated?';else if(vol<cfg.minVol*3&&profit>0)flag='thin';
  out.push({id:p.product_id,p,buy,sell,profit,m,vol,hr,dip:dip==null?-999:dip,hasDip:dip!=null,flag,sg:analyze(p.product_id,bid,ask,m)});
 }
 return out;
}

function render(){
 const T=TABS[S.tab],q=$('#q').value.toLowerCase();
 $('#tabs').innerHTML=Object.entries(TABS).map(([k,v])=>`<button data-t="${k}" class="${k==S.tab?'on':''}">${v.n}</button>`).join('');
 $('#desc').textContent=T.d;
 let list=calc().filter(T.f);
 if(q)list=list.filter(r=>nm(r.id).toLowerCase().includes(q));
 list.sort((a,b)=>T.s(b)-T.s(a));
 if(S.tab=='sig')return sigView(list);
 $('#hd').innerHTML=HD;
 $('#rows').innerHTML=list.slice(0,100).map(r=>`<tr data-id="${r.id}">
 <td>${nm(r.id)}</td><td>${fmt(r.buy)}</td><td>${fmt(r.sell)}</td>
 <td class="${r.profit>0?'up':'dn'}">${fmt(r.profit)}</td>
 <td class="${r.m>0?'up':'dn'}">${r.m.toFixed(1)}%</td>
 <td>${fmt(r.vol)}</td><td>${fmt(r.hr)}</td>
 <td class="${r.dip>0?'up':''}">${r.hasDip?r.dip.toFixed(1)+'%':'—'}</td>
 <td class="warn">${r.flag}</td></tr>`).join('')||`<tr><td colspan="9" class="mut" style="text-align:center;padding:24px">${S.tab=='dip'&&S.hist.length<6?'Not enough history yet — keep this page open and check back soon.':'No items match right now.'}</td></tr>`;
 if(S.sel)detail(S.sel);
}

function chart(id){
 const pts=S.hist.filter(h=>h.p[id]).map(h=>[h.t,...h.p[id]]);
 if(pts.length<2)return '<p class="mut">No history for this item yet. A snapshot is saved every 5 minutes while this page is open (top 200 items by volume).</p>';
 const W=640,H=200,P=48,t0=pts[0][0],t1=pts[pts.length-1][0];
 const all=pts.flatMap(p=>[p[1],p[2]]),lo=Math.min(...all),hi=Math.max(...all);
 const x=t=>P+(t-t0)/(t1-t0||1)*(W-P-8),y=v=>H-24-(v-lo)/((hi-lo)||1)*(H-44);
 const line=(i,c)=>`<polyline fill="none" stroke="${c}" stroke-width="2" points="${pts.map(p=>x(p[0]).toFixed(1)+','+y(p[i]).toFixed(1)).join(' ')}"/>`;
 const hrs=((t1-t0)/36e5).toFixed(1);
 return `<svg viewBox="0 0 ${W} ${H}" width="100%" style="max-width:700px">
 <text x="4" y="${y(hi)+4}" fill="#8b93a3" font-size="11">${fmt(hi)}</text>
 <text x="4" y="${y(lo)+4}" fill="#8b93a3" font-size="11">${fmt(lo)}</text>
 <line x1="${P}" x2="${W-8}" y1="${H-24}" y2="${H-24}" stroke="#262b36"/>
 ${line(1,'#f87171')}${line(2,'#4ade80')}
 <text x="${P}" y="${H-6}" fill="#8b93a3" font-size="11">${hrs}h of history</text>
 <text x="${W-170}" y="12" fill="#f87171" font-size="11">● Lowest sell offer</text>
 <text x="${W-170}" y="26" fill="#4ade80" font-size="11">● Highest buy order</text></svg>`;
}

function detail(id){
 const r=calc().find(x=>x.id==id);if(!r){return}
 const q=r.p.quick_status,book=(arr)=>`<table><tr><th>Price</th><th>Amount</th><th>Orders</th></tr>${arr.slice(0,5).map(o=>`<tr><td>${fmt(o.pricePerUnit)}</td><td>${fmt(o.amount)}</td><td>${o.orders}</td></tr>`).join('')}</table>`;
 $('#det').innerHTML=`<h2>${nm(id)}<button id="x" title="Close">×</button></h2>
 <div class="g">
 <div>Instant buy<b>${fmt(q.buyPrice)}</b></div><div>Instant sell<b>${fmt(q.sellPrice)}</b></div>
 <div>Spread<b>${fmt(r.p.buy_summary[0].pricePerUnit-r.p.sell_summary[0].pricePerUnit)}</b></div>
 <div>Bought / wk<b>${fmt(q.buyMovingWeek)}</b></div><div>Sold / wk<b>${fmt(q.sellMovingWeek)}</b></div>
 <div>Sell offers<b>${fmt(q.buyOrders)}</b></div><div>Buy orders<b>${fmt(q.sellOrders)}</b></div></div>
 ${anBlock(r)}${chart(id)}
 <div class="books"><div><b>Top buy orders</b>${book(r.p.sell_summary)}</div><div><b>Top sell offers</b>${book(r.p.buy_summary)}</div></div>`;
}

function snap(){
 const now=Date.now();
 if(S.hist.length&&now-S.hist[S.hist.length-1].t<3e5)return;
 const top=Object.values(S.raw).sort((a,b)=>Math.min(b.quick_status.buyMovingWeek,b.quick_status.sellMovingWeek)-Math.min(a.quick_status.buyMovingWeek,a.quick_status.sellMovingWeek)).slice(0,200);
 const p={};
 top.forEach(x=>{const a=x.buy_summary[0],b=x.sell_summary[0];if(a&&b)p[x.product_id]=[r1(a.pricePerUnit),r1(b.pricePerUnit)]});
 S.hist.push({t:now,p});
 while(S.hist.length>288)S.hist.shift();
 updSeas();
 try{localStorage.setItem('bzh',JSON.stringify(S.hist))}catch(e){S.hist.splice(0,80)}
}

async function load(){
 try{
  const j=await(await fetch(API)).json();
  if(!j.success)throw new Error(j.cause||'API error');
  S.raw=j.products;snap();render();alerts();
  $('#st').textContent='Live · updated '+new Date().toLocaleTimeString()+' · '+S.hist.length+' history snapshots';
 }catch(e){$('#st').textContent='Could not reach the Hypixel API ('+e.message+'). Open this file locally or host it on your own site.'}
}

const HD=$('#hd').innerHTML;
const hh=h=>String(h).padStart(2,'0')+':00';
function series(){const s={};S.hist.forEach(h=>{for(const id in h.p)(s[id]=s[id]||[]).push(h.p[id])});return s}
function ema(a,n){const k=2/(n+1);return a.reduce((e,v)=>e+(v-e)*k,a[0])}
function season(id){
 const b=SEAS[id];if(!b)return null;
 const av=b.s.map((v,i)=>b.n[i]>=36?v/b.n[i]:null),ok=av.map((v,i)=>[v,i]).filter(x=>x[0]!=null);
 if(ok.length<12)return null;
 const lo=ok.reduce((a,x)=>x[0]<a[0]?x:a),hi=ok.reduce((a,x)=>x[0]>a[0]?x:a);
 return{av,buy:lo[1],sell:hi[1],buyPct:(lo[0]-1)*100,sellPct:(hi[0]-1)*100,now:av[new Date().getHours()]};
}
function updSeas(){
 const av=avgMap(),h=new Date().getHours(),cur=S.hist[S.hist.length-1].p;
 for(const id in cur){const a=av[id];if(!a||a.length<12)continue;const mu=a.reduce((x,y)=>x+y,0)/a.length;if(!mu)continue;
  const b=SEAS[id]=SEAS[id]||{s:Array(24).fill(0),n:Array(24).fill(0)};b.s[h]=+(b.s[h]+cur[id][1]/mu).toFixed(4);b.n[h]++}
 try{localStorage.setItem('bzs',JSON.stringify(SEAS))}catch(e){}
}
function analyze(id,bid,ask,m){
 const s=SER[id];if(!s||s.length<20)return null;
 const px=(a,b)=>(a+b)/2,mid=s.map(x=>px(x[0],x[1]));mid.push(px(ask,bid));
 const cs=(ask-bid)/px(ask,bid)*100,sp=s.map(x=>(x[0]-x[1])/px(x[0],x[1])*100);
 let g=0,l=0;const L=mid.slice(-15);
 for(let i=1;i<L.length;i++){const d=L[i]-L[i-1];if(d>0)g+=d;else l-=d}
 const rsi=l==0?(g==0?50:100):100-100/(1+g/l);
 const W=mid.slice(-20),mu=W.reduce((a,b)=>a+b,0)/W.length,sd=Math.sqrt(W.reduce((a,b)=>a+(b-mu)**2,0)/W.length);
 const pb=sd?Math.min(1,Math.max(0,(mid[mid.length-1]-(mu-2*sd))/(4*sd))):0.5;
 const es=ema(mid,48),tr=(ema(mid,12)-es)/es*100,vl=sd/mu*100;
 const sm=sp.reduce((a,b)=>a+b,0)/sp.length,ss=Math.sqrt(sp.reduce((a,b)=>a+(b-sm)**2,0)/sp.length)||1,z=(cs-sm)/ss;
 const sea=season(id),w=[];let c=50;
 if(rsi<35){c+=15;w.push('oversold (RSI '+rsi.toFixed(0)+')')}
 if(rsi>65){c-=20;w.push('overbought (RSI '+rsi.toFixed(0)+')')}
 if(pb<.2){c+=15;w.push('near lower Bollinger band')}
 if(pb>.8){c-=15;w.push('near upper band')}
 if(z>1){c+=10;w.push('spread wider than usual')}
 if(tr<-4){c-=10;w.push('falling fast (EMA)')}
 if(tr>1&&rsi<60){c+=5;w.push('uptrend')}
 if(sea&&sea.now!=null){if(sea.now<0.99){c+=8;w.push('usually cheap at this hour')}else if(sea.now>1.01){c-=8;w.push('usually pricey at this hour')}}
 if(vl>8){c-=15;w.push('volatile')}
 if(m>=3)c+=5;
 c=Math.max(0,Math.min(100,Math.round(c)));
 const act=(m>=40||vl>12)?'AVOID':c>=70?'BUY':c>=50?'HOLD':'WAIT';
 return{act,conf:c,rsi,pb,tr,z,vol:vl,sea,why:w.slice(0,3).join(', ')};
}
function sigView(list){
 $('#hd').innerHTML='<th>Item</th><th>Call</th><th>Score</th><th>Buy order @</th><th>Profit/item</th><th>RSI</th><th>Best buy / sell time</th><th style="text-align:left">Why</th>';
 $('#rows').innerHTML=list.slice(0,60).map(r=>{const g=r.sg,se=g.sea;return `<tr data-id="${r.id}"><td>${nm(r.id)}</td><td><span class="chip ${g.act}">${g.act}</span></td><td>${g.conf}</td><td>${fmt(r.buy)}</td><td class="up">${fmt(r.profit)}</td><td>${g.rsi.toFixed(0)}</td><td>${se?hh(se.buy)+' / '+hh(se.sell):'—'}</td><td class="why">${g.why||'no strong signal'}</td></tr>`}).join('')||`<tr><td colspan="8" class="mut" style="text-align:center;padding:24px">${S.hist.length<20?'Collecting data… signals need ~20 snapshots (about 100 minutes of the page or app running).':'No actionable signals right now.'}</td></tr>`;
 if(S.sel)detail(S.sel);
}
function anBlock(r){
 const g=r.sg;if(!g)return '<p class="mut">Analysis needs ~20 history snapshots (about 100 min) or this item is outside the tracked top 200.</p>';
 const se=g.sea;let bars='';
 if(se){const v=se.av.filter(x=>x!=null),mx=Math.max(...v),mn=Math.min(...v),h=x=>(x-mn)/((mx-mn)||1)*40+5;
  bars=`<svg viewBox="0 0 240 50" width="100%" style="max-width:420px">${se.av.map((x,i)=>x==null?'':`<rect x="${i*10}" y="${50-h(x)}" width="8" height="${h(x)}" fill="${i==se.buy?'#4ade80':i==se.sell?'#f87171':'#475569'}"/>`).join('')}</svg><div class="mut">Typical price by hour of day. Cheapest ${hh(se.buy)} (${se.buyPct.toFixed(1)}%), priciest ${hh(se.sell)} (+${se.sellPct.toFixed(1)}%) vs daily average.</div>`}
 return `<div class="g"><div>Call<b><span class="chip ${g.act}">${g.act}</span> ${g.conf}</b></div><div>RSI(14)<b>${g.rsi.toFixed(0)}</b></div><div>Bollinger %B<b>${(g.pb*100).toFixed(0)}%</b></div><div>Trend (EMA 1h vs 4h)<b>${g.tr.toFixed(1)}%</b></div><div>Spread z-score<b>${g.z.toFixed(1)}</b></div><div>Volatility<b>${g.vol.toFixed(1)}%</b></div></div><p class="mut">${g.why||''}</p>${bars}`;
}
function notify(t,b){try{if(window.Android&&Android.notify)return Android.notify(t,b);if('Notification' in window&&Notification.permission=='granted')new Notification(t,{body:b})}catch(e){}}
function alerts(){
 if(!+cfg.al)return;
 const now=Date.now();let N={};try{N=JSON.parse(localStorage.getItem('bzn')||'{}')}catch(e){}
 calc().filter(r=>r.sg&&r.sg.act=='BUY'&&r.sg.conf>=cfg.mc&&r.profit>0&&r.vol>=cfg.minVol).sort((a,b)=>b.sg.conf-a.sg.conf).slice(0,3).forEach(r=>{
  if(now-(N[r.id]||0)<72e5)return;N[r.id]=now;
  notify('BUY: '+nm(r.id),`Buy order @ ${fmt(r.buy)}, sell @ ${fmt(r.sell)}. +${fmt(r.profit)}/item (${r.m.toFixed(1)}%), score ${r.sg.conf}. ${r.sg.why}`)});
 try{localStorage.setItem('bzn',JSON.stringify(N))}catch(e){}
}
$('#tabs').onclick=e=>{const t=e.target.dataset.t;if(t){S.tab=t;render()}};
$('#rows').onclick=e=>{const tr=e.target.closest('tr');if(tr&&tr.dataset.id){S.sel=tr.dataset.id;detail(S.sel);scrollTo({top:0,behavior:'smooth'})}};
$('#det').onclick=e=>{if(e.target.id=='x'){S.sel=null;$('#det').innerHTML=''}};
const bind=(id,k,f=Number)=>{const el=$(id);el.value=cfg[k];el.onchange=()=>{cfg[k]=f(el.value);try{localStorage.setItem('bzc',JSON.stringify(cfg))}catch(e){}render()}};
bind('#tax','tax');bind('#al','al');bind('#mc','mc');bind('#purse','purse');bind('#mv','minVol');bind('#sh','share');
$('#q').oninput=render;
const o=$('#al').onchange;$('#al').onchange=()=>{o();if(+cfg.al&&!window.Android&&window.Notification&&Notification.permission=='default')Notification.requestPermission()};
load();setInterval(load,30000);
</script></body></html>
